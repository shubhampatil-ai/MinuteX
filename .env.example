# =============================================================
# AI_recorder — backend + transcription config
# Copy this file to `.env` and fill in real values.
#
# CREDENTIALS ARE NEVER STORED HERE. The AWS CLI and boto3 read
# your local ~/.aws profile (aws configure). This file holds only
# non-secret configuration plus the transcription/summary keys and the device
# simulator's provisioned API key.
# =============================================================

# --- Required before Stage 1 ---
AWS_REGION=ap-south-1
BUCKET_NAME=CHANGE_ME_your_existing_bucket

# --- Resource names (defaults are fine; scripts are idempotent) ---
TABLE_NAME=DeviceKeys
DEVICES_TABLE=Devices
USERS_TABLE=Users
USER_DEVICES_TABLE=UserDevices
RECORDINGS_TABLE=recordings
CRM_CONNECTIONS_TABLE=CrmConnections
# --- Organization layer (scripts 31/32/33) ---
# Contacts (people), Folders (meeting grouping), FolderContacts (the
# many-to-many between them), MeetingParticipants (speaker label -> contact)
# and Tasks (first-class, queryable across meetings). Created by
# scripts/31_create_workspace_tables.sh; wired by 33_deploy_workspace_org.sh.
CONTACTS_TABLE=Contacts
FOLDERS_TABLE=Folders
FOLDER_CONTACTS_TABLE=FolderContacts
MEETING_PARTICIPANTS_TABLE=MeetingParticipants
TASKS_TABLE=Tasks
USERAPI_LAMBDA_NAME=userApi
LAMBDA_NAME=getUploadUrl
ROLE_NAME=getUploadUrl-role
API_NAME=iot-audio-api
URL_EXPIRY=900

# --- Filled in AFTER you run the deploy scripts ---
# scripts/03_create_apigateway.sh prints this (the HTTP API base URL).
# The full endpoint the device calls is: ${API_URL}/get-upload-url
API_URL=

# --- Device simulator (stand-in for your ESP32 firmware) ---
# scripts/provision_device.py prints DEVICE_API_KEY once when you
# provision a device. DEVICE_ID is informational (the backend always
# resolves the real deviceId from DynamoDB, never from the client).
DEVICE_API_KEY=
DEVICE_ID=esp32-001

# --- Stage 2: Transcription (ElevenLabs Scribe) + Summary (Groq) ---
# Transcription: get a key at https://elevenlabs.io/ (Speech-to-Text / Scribe).
# Summary: get a key at https://console.groq.com/. ElevenLabs STT has no
# built-in summarizer, so the transcript is summarized by a Groq chat model.
ELEVENLABS_API_KEY=
# Optional model overrides (defaults are fine):
# ELEVENLABS_MODEL=scribe_v2
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# (Salesforce CRM variables are documented in their own section below.)

# --- Salesforce CRM integration (Phase 1: OAuth connect) ---
# From your Salesforce Connected App (Setup -> App Manager -> New Connected App,
# enable OAuth with scopes "api" + "refresh_token, offline_access" + "openid").
# The Connected App's Callback URL must EXACTLY equal SALESFORCE_REDIRECT_URI.
#
# scripts/23_deploy_salesforce_oauth.sh reads CLIENT_SECRET from here and moves
# it into Secrets Manager — it never becomes a plaintext Lambda env var. Only
# the non-secret CLIENT_ID/URLs are set as env vars on the function.
SALESFORCE_CLIENT_ID=REPLACE_WITH_SALESFORCE_CLIENT_ID
SALESFORCE_CLIENT_SECRET=REPLACE_WITH_SALESFORCE_CLIENT_SECRET
# Production orgs: https://login.salesforce.com  |  Sandboxes: https://test.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Defaults to ${API_URL}/crm/salesforce/callback if left blank.
SALESFORCE_REDIRECT_URI=
# Deep link the callback redirects the browser to when the exchange finishes.
# Must match the app's scheme from app/recorder-app/app.json ("recorderapp"),
# because expo-web-browser's openAuthSessionAsync only closes the browser when
# it sees a redirect to exactly this URL.
SALESFORCE_RETURN_URL=recorderapp://crm-connected
# Printed by 23_deploy_salesforce_oauth.sh on first run — paste it back here so
# later runs reuse the same key instead of creating another one.
SALESFORCE_KMS_KEY_ID=

# --- Integrations / Gmail (Phase 1: connect + send) ---
# ONE Google OAuth client serves every Google-family integration; Gmail today,
# Calendar/Tasks later differ only by the scopes requested at authorize time.
#
# Google Cloud Console setup (scripts/40_deploy_gmail_integration.sh cannot do
# this for you — see that script's header for the full checklist):
#   * Enable the Gmail API
#   * OAuth consent screen with EXACTLY these scopes (nothing more — no inbox
#     read scope is requested, by design):
#       https://www.googleapis.com/auth/gmail.send
#       https://www.googleapis.com/auth/userinfo.email
#   * Credentials -> OAuth client ID -> "Web application" (NOT Android/iOS:
#     the code exchange happens server-side with the client secret, and the
#     mobile app never sees a Google credential)
#
# Script 40 reads CLIENT_SECRET from here and moves it into Secrets Manager —
# it never becomes a plaintext Lambda env var.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
# Defaults to ${API_URL}/integrations/gmail/callback if left blank. Must match
# the Authorized redirect URI on the Google OAuth client EXACTLY.
GOOGLE_REDIRECT_URI=
# Deep link the callback redirects the browser to when the exchange finishes.
# Must match the app's scheme from app/app.json, because expo-web-browser's
# openAuthSessionAsync only closes the browser on a redirect to exactly this URL.
INTEGRATION_RETURN_URL=recorderapp://integrations-connected
# Printed by 40_deploy_gmail_integration.sh on first run — paste it back here
# so later runs reuse the same key instead of creating another one.
INTEGRATIONS_KMS_KEY_ID=
# DynamoDB table created by scripts/39_create_integrations_table.sh.
INTEGRATIONS_TABLE=Integrations
